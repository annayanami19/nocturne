{
  "manifest_version": 3,
  "name": "Nocturne — Dark Mode",
  "description": "Ubah halaman web mana pun menjadi dark mode instan: smart invert, toggle per-situs, dan kontrol kecerahan/kontras/kehangatan.",
  "version": "1.0.0",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Nocturne — Dark Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-DhemFIu6.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Aktif/nonaktifkan mode gelap"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/storage-DNZLZt1W.js",
        "assets/types-D8aBjTj5.js",
        "assets/index.ts-D65BRYuN.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
